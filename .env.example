# Copy this file to .env and fill in the values.

# Groq API key: create one free at https://console.groq.com/keys
GROQ_API_KEY=

# Model and endpoint. Any OpenAI-compatible API works; these are the Groq defaults.
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
# GPT-OSS reasoning depth: low | medium | high
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=2048

# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file
DATABASE_URL=sqlite:///./scholarpilot.db

# Comma-separated emails that get admin (catalog review) rights on signup
ADMIN_EMAILS=

# Run the official-page monitor once a day inside the server (true/false)
MONITOR_ENABLED=false
MONITOR_HOUR=6

# Optional SMTP settings. If empty, approved emails open in the student's own mail app instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
